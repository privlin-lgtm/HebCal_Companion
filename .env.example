# Copy to .env.local and fill in your own Supabase project values.
# Both are safe to expose in a client bundle: the publishable key only grants
# what row level security allows. Never put a service_role or sb_secret_ key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
